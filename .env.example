# Chat model: OpenAI-compatible DeepSeek gateway. Override any value in the
# shell or IDE run configuration; never commit a real API key.
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=
LLM_STREAMING=false
LLM_TIMEOUT_SECONDS=260
LLM_MAX_RETRIES=3
LLM_SYSTEM_PROMPT=You are a helpful knowledge graph assistant.
# /no_think is a Qwen-specific soft switch, so leave it disabled for DeepSeek.
LLM_DISABLE_THINKING=false

# Neo4j
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_QUERY_LIMIT=200
NEO4J_ENTITY_VECTOR_INDEX=
NEO4J_RELATION_VECTOR_INDEX=
NEO4J_TYPE_VECTOR_INDEX=

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=
REDIS_TTL_SECONDS=0
REDIS_SOCKET_TIMEOUT_SECONDS=2
MEMORY_MAX_MESSAGES=20

# EmbeddingGemma via local Ollama Docker container. The model and its 768-wide
# output are pinned in EmbeddingGemmaClient, not configurable here.
EMBEDDING_BASE_URL=
EMBEDDING_INDEX_NAME=
EMBEDDING_TIMEOUT_SECONDS=120

# Optional application settings
KGDEMO_RUN_DIR=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT_SECONDS=5
